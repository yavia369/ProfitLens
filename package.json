{
  "name": "profitlens",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22.19"
  },
  "scripts": {
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "db:generate": "pnpm --filter @profitlens/db db:generate",
    "db:migrate": "pnpm --filter @profitlens/db db:migrate"
  },
  "devDependencies": {
    "turbo": "2.11.9",
    "typescript": "6.0.3",
    "@types/node": "22.20.5"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
