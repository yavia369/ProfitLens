# Copy to .env (never commit .env)
DATABASE_URL=postgres://profitlens:profitlens@localhost:5432/profitlens
TEST_DATABASE_URL=postgres://profitlens:profitlens@localhost:5432/profitlens_test
# AES-256-GCM keys for credential encryption: JSON map of key id -> base64(32 bytes)
ENCRYPTION_KEYS={"k1":"REPLACE_WITH_BASE64_32_BYTES"}
ENCRYPTION_ACTIVE_KID=k1
APP_URL=http://localhost:3000
BETTER_AUTH_SECRET=REPLACE_WITH_RANDOM_32_BYTES
SHOPIFY_API_VERSION=2026-10
# Google Ads (Phase 6). Worker CLI only (`pnpm --filter @profitlens/worker sync ads-connect <email>`); in the cloud dev
# environment these are environment variables, never in a file. See docs/GOOGLE_ADS_SETUP.md. Leave empty here.
GOOGLE_ADS_SERVICE_ACCOUNT_KEY=
GOOGLE_ADS_LOGIN_CUSTOMER_ID=
# Meta Ads (CLI `sync meta-connect` only; the web app takes the token in Settings). See docs/META_ADS_SETUP.md.
# Environment variables only, never in a committed file. META_APP_ID/SECRET only for 60-day tokens.
META_SYSTEM_USER_TOKEN=
META_APP_ID=
META_APP_SECRET=
# Stripe / PayPal (CLI `sync payments-connect` only; the web app takes them in Settings). See docs/PAYMENT_GATEWAYS_SETUP.md.
# Stripe: a restricted key (rk_live_…) with Read on Balance, Charges and PaymentIntents only. PayPal: a REST app with Transaction Search enabled.
STRIPE_SECRET_KEY=
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# Optional, worker CLI only (`pnpm --filter @profitlens/worker sync connect <email>`): store-owned Dev Dashboard app.
# In the cloud dev environment these are set as environment variables, never in a file. Leave empty here.
SHOPIFY_SHOP_DOMAIN=
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
